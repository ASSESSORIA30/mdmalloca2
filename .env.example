# ─── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.example.com
# en | es | ca — initial language when the browser expresses no preference
NEXT_PUBLIC_DEFAULT_LOCALE=en
# true while demonstration media are in use (shows notices, blocks indexing)
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# ─── Content source ──────────────────────────────────────────────────
# files (default: content/properties/*.json) | supabase (table public.properties)
CONTENT_SOURCE=files

# ─── Supabase (server only — never prefix with NEXT_PUBLIC_) ─────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Notifications (server only) ─────────────────────────────────────
RESEND_API_KEY=
SALES_EMAIL=sales@example.com
EMAIL_FROM="ModularDom <noreply@example.com>"
# optional: POSTs every enquiry as JSON (Zapier, Make, HubSpot, Pipedrive...)
CRM_WEBHOOK_URL=

# ─── Anti-spam (optional, Cloudflare Turnstile) ──────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Maps ────────────────────────────────────────────────────────────
# Satellite imagery: Mapbox if set (recommended for production), else Esri World Imagery
NEXT_PUBLIC_MAPBOX_TOKEN=
# Vector map style URL (default: OpenFreeMap Positron, recoloured to the palette)
NEXT_PUBLIC_MAP_STYLE=

# ─── Admin (Basic auth for /admin) ───────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=
